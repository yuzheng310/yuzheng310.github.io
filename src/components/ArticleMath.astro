<script>
  const prose = document.querySelector<HTMLElement>('.prose');
  if (prose) {
    // KaTeX can wrap between relation/operator groups. Fit only equations whose
    // indivisible group (for example a matrix) is still wider than the column.
    const fitEquations = () => {
      const normalSize = parseFloat(getComputedStyle(prose).fontSize) * 1.04;
      prose.querySelectorAll<HTMLElement>('.katex-display > .katex').forEach(math => {
        math.style.fontSize = `${normalSize}px`;
        const html = math.querySelector<HTMLElement>('.katex-html');
        if (!html) return;
        const available = math.clientWidth;
        const widest = Math.max(0, ...Array.from(html.children, child => child.getBoundingClientRect().width));
        if (available && widest > available) {
          math.style.fontSize = `${normalSize * (available - 2) / widest}px`;
        }
      });
    };
    let width = 0;
    const observer = new ResizeObserver(entries => {
      const nextWidth = entries[0].contentRect.width;
      if (Math.abs(nextWidth - width) > 1) { width = nextWidth; fitEquations(); }
    });
    observer.observe(prose);
    document.fonts.ready.then(fitEquations);
  }
</script>
