<nav class="article-navigation" aria-label="文章目录" hidden>
  <details>
    <summary>本文目录 <span aria-hidden="true">＋</span></summary>
    <ol></ol>
  </details>
</nav>
<script>
  const navigation = document.querySelector<HTMLElement>('.article-navigation');
  const details = navigation?.querySelector('details');
  const list = navigation?.querySelector('ol');
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2, .prose h3')]
    .filter(heading => heading.textContent?.trim() !== '目录');

  if (navigation && details && list && headings.length > 1) {
    const desktop = window.matchMedia('(min-width: 1000px)');
    let navigating = false;
    let settleTimer: number | undefined;
    const links = headings.map((heading, index) => {
      if (!heading.id) {
        let id = `section-${index + 1}`;
        while (document.getElementById(id)) id += '-section';
        heading.id = id;
      }
      const item = document.createElement('li');
      if (heading.tagName === 'H3') item.className = 'toc-subsection';
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      // KaTeX includes both accessible MathML and visible HTML; avoid duplicate labels.
      const label = heading.cloneNode(true) as HTMLElement;
      label.querySelectorAll('.katex-mathml').forEach(node => node.remove());
      link.textContent = label.textContent;
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        // Keep the clicked entry stable while native smooth scrolling crosses
        // intermediate chapters. Resume scroll tracking when the page settles.
        navigating = true;
        setActive(index, false);
        if (!desktop.matches) details.open = false;
        scheduleSettle();
      });
      item.append(link);
      list.append(item);
      return link;
    });
    navigation.hidden = false;
    const syncLayout = () => { details.open = desktop.matches; };
    syncLayout();
    desktop.addEventListener('change', syncLayout);
    details.querySelector('summary')?.addEventListener('click', event => {
      if (desktop.matches) event.preventDefault();
    });
    navigation.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !desktop.matches) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });

    let active = -1;
    let scheduled = false;
    const setActive = (index: number, follow = true) => {
      if (index === active) return;
      if (active >= 0) links[active].removeAttribute('aria-current');
      active = index;
      const link = links[index];
      link.setAttribute('aria-current', 'location');
      if (follow && desktop.matches) {
        const item = link.getBoundingClientRect();
        const bounds = list.getBoundingClientRect();
        if (item.top < bounds.top || item.bottom > bounds.bottom) {
          list.scrollTop += item.top - bounds.top - list.clientHeight / 3;
        }
      }
    };
    const updateActive = () => {
      scheduled = false;
      if (navigating) return;
      // Include both the heading's scroll margin and the page's scroll padding.
      const offset = 120;
      let index = 0;
      headings.forEach((heading, candidate) => {
        if (heading.getBoundingClientRect().top <= offset) index = candidate;
      });
      setActive(index);
    };
    function finishNavigation() {
      window.clearTimeout(settleTimer);
      navigating = false;
      updateActive();
    }
    function scheduleSettle() {
      window.clearTimeout(settleTimer);
      // A quiet period also handles same-anchor clicks and interrupted scrolls.
      // Native scrollend can belong to an older animation after rapid clicks.
      settleTimer = window.setTimeout(finishNavigation, 180);
    }
    document.addEventListener('scroll', () => {
      if (navigating) { scheduleSettle(); return; }
      if (!scheduled) { scheduled = true; requestAnimationFrame(updateActive); }
    }, { passive: true });
    updateActive();
    window.addEventListener('resize', updateActive);
  }
</script>
