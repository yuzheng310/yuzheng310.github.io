---
import ReadingPreferences from './ReadingPreferences.astro';
---
<nav class="article-navigation" aria-label="阅读设置与文章目录">
  <button class="sidebar-toggle" type="button" aria-controls="reading-sidebar-panel" aria-expanded="true" aria-label="收起侧边栏" title="收起侧边栏" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/><path class="sidebar-chevron" d="m16 9-3 3 3 3"/></svg>
    <span>收起侧边栏</span>
  </button>
  <div id="reading-sidebar-panel">
    <ReadingPreferences />
    <details class="toc-details" hidden>
      <summary>本文目录 <span aria-hidden="true">＋</span></summary>
      <ol></ol>
    </details>
  </div>
</nav>
<script>
  const navigation = document.querySelector<HTMLElement>('.article-navigation');
  const sidebarToggle = navigation?.querySelector<HTMLButtonElement>('.sidebar-toggle');
  if (sidebarToggle) {
    const root = document.documentElement;
    const desktop = window.matchMedia('(min-width: 1000px)');
    const syncToggle = () => {
      const collapsed = desktop.matches && root.dataset.articleSidebar === 'collapsed';
      const label = collapsed ? '展开侧边栏' : '收起侧边栏';
      sidebarToggle.setAttribute('aria-expanded', String(!collapsed));
      sidebarToggle.setAttribute('aria-label', label);
      sidebarToggle.title = label;
      sidebarToggle.querySelector('span')!.textContent = label;
    };
    sidebarToggle.hidden = false;
    syncToggle();
    desktop.addEventListener('change', syncToggle);
    sidebarToggle.addEventListener('click', () => {
      if (!desktop.matches) return;
      // Preserve the visible paragraph when the wider reading column reflows.
      const anchor = [...document.querySelectorAll<HTMLElement>('.article-main :is(h1, h2, h3, p, pre, li, table)')]
        .find(element => { const rect = element.getBoundingClientRect(); return rect.bottom > 120 && rect.top < innerHeight; });
      const before = anchor?.getBoundingClientRect().top;
      const preservePosition = window.scrollY > 0;
      root.dataset.articleSidebar = root.dataset.articleSidebar === 'collapsed' ? 'expanded' : 'collapsed';
      try { localStorage.setItem('article-sidebar', root.dataset.articleSidebar); } catch { /* Optional persistence. */ }
      syncToggle();
      document.dispatchEvent(new Event('article-sidebar-change'));
      // Allow equation fitting to finish after the column's ResizeObserver runs.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (preservePosition && anchor && before !== undefined) {
          window.scrollBy({ top: anchor.getBoundingClientRect().top - before, behavior: 'instant' });
        }
      }));
    });
  }
  const details = navigation?.querySelector<HTMLDetailsElement>('.toc-details');
  const list = navigation?.querySelector('ol');
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2, .prose h3')]
    .filter(heading => heading.textContent?.trim() !== '目录');

  if (navigation && details && list && headings.length > 1) {
    const desktop = window.matchMedia('(min-width: 1000px)');
    let navigating = false;
    let navigationTarget: HTMLElement | undefined;
    let settleTimer: number | undefined;
    const links = headings.map((heading, index) => {
      if (!heading.id) {
        let id = `section-${index + 1}`;
        while (document.getElementById(id)) id += '-section';
        heading.id = id;
      }
      const item = document.createElement('li');
      if (heading.tagName === 'H3') item.className = 'toc-subsection';
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      // KaTeX includes both accessible MathML and visible HTML; avoid duplicate labels.
      const label = heading.cloneNode(true) as HTMLElement;
      label.querySelectorAll('.katex-mathml').forEach(node => node.remove());
      link.textContent = label.textContent;
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        // Keep the clicked entry stable while native smooth scrolling crosses
        // intermediate chapters. Resume scroll tracking when the page settles.
        navigating = true;
        navigationTarget = heading;
        setActive(index, false);
        if (!desktop.matches) details.open = false;
        scheduleSettle();
      });
      item.append(link);
      list.append(item);
      return link;
    });
    details.hidden = false;
    const syncLayout = () => { details.open = desktop.matches; };
    syncLayout();
    desktop.addEventListener('change', syncLayout);
    details.querySelector('summary')?.addEventListener('click', event => {
      if (desktop.matches) event.preventDefault();
    });
    navigation.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !desktop.matches) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });

    let active = -1;
    let scheduled = false;
    const revealActiveLink = () => {
      if (!desktop.matches || active < 0 || !list.clientHeight) return;
      const item = links[active].getBoundingClientRect();
      const bounds = list.getBoundingClientRect();
      if (item.top < bounds.top || item.bottom > bounds.bottom) {
        list.scrollTop += item.top - bounds.top - list.clientHeight / 3;
      }
    };
    const setActive = (index: number, follow = true) => {
      if (index === active) return;
      if (active >= 0) links[active].removeAttribute('aria-current');
      active = index;
      const link = links[index];
      link.setAttribute('aria-current', 'location');
      if (follow) revealActiveLink();
    };
    const updateActive = () => {
      scheduled = false;
      if (navigating) return;
      // Include both the heading's scroll margin and the page's scroll padding.
      const offset = 120;
      let index = 0;
      headings.forEach((heading, candidate) => {
        if (heading.getBoundingClientRect().top <= offset) index = candidate;
      });
      setActive(index);
    };
    function finishNavigation() {
      window.clearTimeout(settleTimer);
      if (navigationTarget) {
        // Font/image reflow can move a heading after native anchor scrolling begins.
        const margin = parseFloat(getComputedStyle(navigationTarget).scrollMarginTop) || 0;
        const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
        const delta = navigationTarget.getBoundingClientRect().top - margin - padding;
        if (Math.abs(delta) > 2) window.scrollBy({ top: delta, behavior: 'instant' });
      }
      navigationTarget = undefined;
      navigating = false;
      updateActive();
    }
    function scheduleSettle() {
      window.clearTimeout(settleTimer);
      // A quiet period also handles same-anchor clicks and interrupted scrolls.
      // Native scrollend can belong to an older animation after rapid clicks.
      settleTimer = window.setTimeout(finishNavigation, 180);
    }
    document.addEventListener('scroll', () => {
      if (navigating) { scheduleSettle(); return; }
      if (!scheduled) { scheduled = true; requestAnimationFrame(updateActive); }
    }, { passive: true });
    const cancelNavigation = () => {
      window.clearTimeout(settleTimer);
      navigationTarget = undefined;
      navigating = false;
    };
    window.addEventListener('wheel', cancelNavigation, { passive: true });
    window.addEventListener('touchstart', cancelNavigation, { passive: true });
    window.addEventListener('keydown', event => {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', 'Escape', ' '].includes(event.key)) cancelNavigation();
    });
    updateActive();
    window.addEventListener('resize', updateActive);
    document.addEventListener('article-font-change', () => requestAnimationFrame(updateActive));
    document.addEventListener('article-sidebar-change', () => {
      cancelNavigation();
      requestAnimationFrame(() => requestAnimationFrame(() => {
        updateActive();
        revealActiveLink();
      }));
    });
  }
</script>
