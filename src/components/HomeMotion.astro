---
const ribbons = Array.from({ length: 12 }, (_, i) => `M ${1080 + i * 24} -80 C ${1580 + i * 14} 140, ${910 + i * 24} 350, ${1220 + i * 26} 610 S ${1570 + i * 12} 810, 1710 ${990 + i * 16}`);
const lowerRibbons = Array.from({ length: 8 }, (_, i) => `M -100 ${480 + i * 28} C ${200 + i * 12} 600, ${-210 + i * 22} 830, ${300 + i * 27} 1110`);
---
<div class="home-effects" aria-hidden="true">
  <div class="color-wash"></div>
  <div class="pointer-light"></div>
  <svg class="desktop-ribbons" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id="ribbon-color" x1="950" y1="0" x2="1580" y2="950" gradientUnits="userSpaceOnUse"><stop stop-color="#83b9c9" stop-opacity=".25" /><stop offset=".45" stop-color="#7bafa2" stop-opacity=".4" /><stop offset="1" stop-color="#a9a7ce" stop-opacity=".18" /></linearGradient>
      <linearGradient id="lower-color" x1="0" y1="500" x2="360" y2="1050" gradientUnits="userSpaceOnUse"><stop stop-color="#9dbfa5" stop-opacity=".12" /><stop offset=".65" stop-color="#74ada6" stop-opacity=".28" /><stop offset="1" stop-color="#a2b9ce" stop-opacity=".1" /></linearGradient>
    </defs>
    <g class="ribbon-field">
      {ribbons.map(d => <path d={d} stroke="url(#ribbon-color)" stroke-width=".8" />)}
      {ribbons.filter((_, i) => i % 3 === 0).map((d, i) => <path class="light-trail" d={d} stroke="#6fa699" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 380" style={`--delay: ${i * -3}s`} />)}
    </g>
    <g class="lower-field">{lowerRibbons.map(d => <path d={d} stroke="url(#lower-color)" stroke-width=".8" />)}</g>
    <g class="particles" fill="#70a295">
      {[[1270,190],[1430,430],[1130,620],[1510,740],[75,460],[150,830],[350,930]].map(([x,y], i) => <circle cx={x} cy={y} r={i % 2 === 0 ? 2 : 1.5} style={`--delay: ${i * -2}s`} />)}
    </g>
  </svg>
  <svg class="mobile-ribbons" viewBox="0 0 400 900" preserveAspectRatio="xMidYMid slice" fill="none">
    <g class="ribbon-field" stroke="#8cb6aa" stroke-opacity=".2" stroke-width=".65">
      {Array.from({length: 6}, (_, i) => <path d={`M ${330+i*17} -30 C ${510+i*15} 170, ${220+i*17} 260, ${340+i*17} 430 S ${490+i*16} 690, ${360+i*20} 950`} />)}
    </g>
  </svg>
</div>
<button type="button" class="effects-toggle" aria-label="暂停首页动效" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span><span class="toggle-label">暂停动效</span></button>

<style>
  :global(body:has(.home-effects) .site) { position: relative; z-index: 1; }
  :global(body:has(.home-effects) .skip) { z-index: 4; }
  .home-effects { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .home-effects svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .mobile-ribbons { display: none; }
  .color-wash { position: absolute; inset: -8%; background: radial-gradient(ellipse at 88% 18%, #bde6e04d, transparent 40%), radial-gradient(ellipse at 2% 78%, #d4e4cc47, transparent 34%), radial-gradient(ellipse at 95% 92%, #dcdcf047, transparent 36%); }
  .pointer-light { position: absolute; inset: 0; background: radial-gradient(340px circle at var(--pointer-x, 85%) var(--pointer-y, 25%), #a2d7c71c, transparent 85%); }
  .light-trail { opacity: .5; }
  .particles { opacity: .45; }
  .effects-toggle { position: fixed; right: 18px; bottom: 16px; z-index: 3; display: inline-flex; align-items: center; gap: 7px; min-height: 32px; padding: 4px 10px; border: 1px solid #dbe4dc; border-radius: 20px; color: #63786d; background: #fafaf7e8; font-family: inherit; font-size: 11px; cursor: pointer; }
  .effects-toggle[hidden] { display: none; }
  .effects-toggle:hover { color: var(--accent); border-color: #adc6b9; }
  .effects-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @property --cta-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  :global(.intro-links .primary-link) { border-color: transparent; background: linear-gradient(#eff8f1, #eff8f1) padding-box, conic-gradient(from var(--cta-angle), #c8e2ce, #75b8aa, #c8e2ce, #a1c2de, #c8e2ce) border-box; }
  :global(.intro-links .primary-link:hover), :global(.intro-links .primary-link:focus-visible) { background: linear-gradient(#e5f4eb, #e5f4eb) padding-box, conic-gradient(from var(--cta-angle), #a2d0b7, #55a897, #a2d0b7, #8aafd0, #a2d0b7) border-box; }
  @media (prefers-reduced-motion: no-preference) {
    .color-wash { animation: wash-drift 18s ease-in-out infinite alternate; }
    .ribbon-field { transform-origin: 85% 40%; animation: ribbon-drift 16s ease-in-out infinite alternate; }
    .lower-field { animation: ribbon-drift 20s ease-in-out infinite alternate-reverse; }
    .light-trail { animation: light-flow 28s var(--delay) linear infinite; }
    .particles circle { animation: particle-drift 12s var(--delay) ease-in-out infinite alternate; }
    :global(.intro-links .primary-link) { animation: border-flow 7s linear infinite; transition: transform 180ms ease, box-shadow 180ms ease; }
    :global(.intro-links .primary-link:hover), :global(.intro-links .primary-link:focus-visible) { transform: translateY(-2px); }
    :global(.primary-link span) { animation: arrow-invite 4.5s ease-in-out infinite; }
    :global(body[data-motion-paused="true"] .home-effects *), :global(body[data-motion-paused="true"] .primary-link), :global(body[data-motion-paused="true"] .primary-link span) { animation-play-state: paused; }
  }
  @keyframes wash-drift { to { transform: translate(-2%, 3%) scale(1.05); } }
  @keyframes ribbon-drift { to { transform: translate(-15px, 12px) rotate(-2deg); } }
  @keyframes light-flow { to { stroke-dashoffset: -766; } }
  @keyframes particle-drift { to { transform: translate(9px, -18px); opacity: .3; } }
  @keyframes border-flow { to { --cta-angle: 360deg; } }
  @keyframes arrow-invite { 0%, 65%, 100% { transform: translateY(0); } 76% { transform: translateY(3px); } 88% { transform: translateY(0); } }
  @media (max-width: 760px) {
    .desktop-ribbons { display: none; }
    .mobile-ribbons { display: block; }
    .pointer-light { display: none; }
    .effects-toggle { right: 10px; bottom: 10px; font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .effects-toggle, .pointer-light { display: none; } }
</style>

<script>
  const effects = document.querySelector<HTMLElement>('.home-effects');
  const toggle = document.querySelector<HTMLButtonElement>('.effects-toggle');
  if (effects && toggle) {
    let paused = false;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => { document.body.dataset.motionPaused = String(paused || document.hidden || reduced.matches); };
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? '播放首页动效' : '暂停首页动效');
      toggle.querySelector('.toggle-label')!.textContent = paused ? '播放动效' : '暂停动效';
      toggle.querySelector('[aria-hidden]')!.textContent = paused ? '▷' : 'Ⅱ';
      update();
    });
    document.addEventListener('visibilitychange', update);
    reduced.addEventListener('change', update);
    let frame = 0;
    let x = 0, y = 0;
    window.addEventListener('pointermove', (event) => {
      if (paused || reduced.matches || event.pointerType !== 'mouse') return;
      x = event.clientX; y = event.clientY;
      if (!frame) frame = requestAnimationFrame(() => {
        effects.style.setProperty('--pointer-x', `${x}px`);
        effects.style.setProperty('--pointer-y', `${y}px`);
        frame = 0;
      });
    }, { passive: true });
    update();
  }
</script>
