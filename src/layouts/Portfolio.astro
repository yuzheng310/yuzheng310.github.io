---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#ffffff"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body><a class="skip" href="#main">跳到正文</a>
<div class="site"><header class="header"><a class="home-link" href="/" aria-label="yuzheng310 首页">yuzheng310</a><nav aria-label="主导航"><a href="/projects/" aria-current={active==='projects'?'page':undefined}>项目</a><a href="/blog/" aria-current={active==='blog'?'page':undefined}>笔记</a><a href="/about/" aria-current={active==='about'?'page':undefined}>关于</a></nav></header>
<main id="main"><slot/></main>
<footer><span>yuzheng310</span><div><a href="https://github.com/yuzheng310" target="_blank" rel="noreferrer">GitHub</a><a href="/rss.xml">RSS</a><a href="https://github.com/markhorn-dev/astro-nano" target="_blank" rel="noreferrer">Astro Nano</a></div></footer></div>
