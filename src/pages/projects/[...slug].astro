---
import { getCollection } from 'astro:content';
import Portfolio from '../../layouts/Portfolio.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';
export async function getStaticPaths() {
  const items = await getCollection('projects', ({ data }) => !data.draft);
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await item.render();
---
<Portfolio title={`${item.data.title} · yuzheng310`} description={item.data.description} active="projects" article>
  <article>
    <a class="back" href="/projects/">← 全部项目</a>
    <header class="article-header"><p class="eyebrow">项目记录</p><h1>{item.data.title}</h1><p class="deck">{item.data.description}</p>{item.data.repoURL && <p class="article-meta"><a href={item.data.repoURL}>查看公开源码 ↗</a></p>}</header>
    <ArticleNavigation />
    <div class="prose"><Content /></div>
    <div class="article-end"><a href="/projects/">← 返回项目列表</a><a href="#main">回到顶部 ↑</a></div>
  </article>
</Portfolio>
