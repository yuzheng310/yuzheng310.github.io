---
import { getCollection } from 'astro:content';
import Portfolio from '../layouts/Portfolio.astro';
import ProjectList from '../components/ProjectList.astro';
const notes = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf() || a.slug.localeCompare(b.slug));
const selected = ['session-kv', 'qwen3-gpu-optimization', 'performance-evidence'].map(slug => notes.find(note => note.slug === slug)!);
const recent = notes.filter(note => note.data.tags.includes('翻译')).slice(0,3);
---
<Portfolio wide homeEffects>
  <section class="intro" aria-labelledby="intro-title">
    <p class="eyebrow hero-greeting"><span class="status-dot" aria-hidden="true"></span>你好，我是</p>
    <h1 id="intro-title">yuzheng<span class="accent">.</span></h1>
    <p class="hero-statement">写代码，研究系统如何工作。</p>
    <p class="intro-description">关注大模型推理、代码 Agent 与数据库。<br />在实现中理解系统，在记录中沉淀思考。</p>
    <div class="intro-links"><a class="primary-link" href="#projects">了解我的项目 <span aria-hidden="true">↓</span></a><a class="secondary-link" href="/blog/">阅读技术笔记 <span aria-hidden="true">↗</span></a></div>
    <p class="hero-footnote">LLM INFERENCE <span>/</span> CODE AGENTS <span>/</span> DATABASE SYSTEMS</p>
  </section>
  <section class="home-section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-title">把想法，放进真实系统。</h2></div><a href="/projects/">全部项目 <span aria-hidden="true">↗</span></a></div>
    <ProjectList />
  </section>
  <section class="home-section" aria-labelledby="notes-title">
    <div class="section-heading"><div><p class="eyebrow">02 / FIELD NOTES</p><h2 id="notes-title">实现之外，再想一步。</h2></div><a href="/blog/">全部笔记 <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">关于执行路径、状态管理与性能取舍的一些记录。</p>
    <div class="note-list">{selected.map(note => <a href={`/blog/${note.slug}/`}><time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time><span class="home-note-content"><span class="note-title">{note.data.title}</span><span class="note-description">{note.data.description}</span></span><span class="note-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="home-section" aria-labelledby="reading-title">
    <div class="section-heading"><div><p class="eyebrow">03 / READING & TRANSLATION</p><h2 id="reading-title">沿着别人的思路，深入一点。</h2></div><a href="/blog/tags/翻译/">翻译与精读 <span aria-hidden="true">↗</span></a></div>
    <div class="reading-list">{recent.map(note => <a href={`/blog/${note.slug}/`}><span class="reading-kicker">{note.data.tags.includes('论文') ? '论文精读' : '翻译与整理'}</span><h3>{note.data.title}</h3><p>{note.data.description}</p><span class="reading-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
  <aside class="currently"><div><p class="eyebrow">KEEP EXPLORING</p><h2>系统很大，慢慢弄明白。</h2><p>继续研究会话 KV、CPU offload，以及推理层与 Agent 的边界。</p></div><div class="connect-links"><a href="/about/">关于我 ↗</a><a href="https://github.com/yuzheng310">GitHub ↗</a><a href="/rss.xml">订阅 RSS ↗</a></div></aside>
</Portfolio>
